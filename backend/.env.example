# Vorlage für .env.stage.<STAGE> (z.B. .env.stage.dev, .env.stage.prod).
# Die Datei wird über STAGE=<stage> ausgewählt, siehe npm-Skripte.

# --- Datenbank (werden zur Mongo-URI zusammengesetzt) ---
MONGODB_URI=mongodb+srv://benutzername:
MONGODB_PW=passwort
MONGODB_CLUSTER=@cluster.example.mongodb.net/waste-connect

# --- Auth ---
JWT_SECRET=bitte-ersetzen

# --- Öffentliche Basis-URL des Frontends (für Links in E-Mails) ---
URL=http://localhost:4200

# --- CORS: kommagetrennte Liste erlaubter Frontend-Origins.
# Ohne Wert erlaubt die Anwendung nur http://localhost:4200. ---
CORS_ORIGINS=http://localhost:4200,https://waste-connect.de,https://www.waste-connect.de,https://recycling.patrick-frantzen.de

# --- Mailversand ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=noreply@example.com
MAIL_PW=passwort
MAIL_FROM=noreply@example.com
# Nur für lokale Testserver mit selbstsigniertem Zertifikat auf true setzen.
MAIL_ALLOW_INSECURE_TLS=false
